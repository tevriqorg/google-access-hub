# Generate these secrets outside the repository.
GAH_ADDR=127.0.0.1:18120
GAH_DATA_FILE=/var/lib/google-access-hub/google-access-hub.json
GAH_MASTER_KEY=<base64-encoded-32-byte-key>
GAH_ADMIN_TOKEN=<random-admin-bearer-token>

# Leave unset until real Google OAuth G4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://auth.example.com/oauth/google/callback
